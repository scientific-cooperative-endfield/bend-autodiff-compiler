  λ+x0 => λ+x1 => λ+x2 => %(LAWS.optimize_sound +x0 +x1) : x3, x4 => {(compiler.exec_vm (compiler.compile (compiler.optimize x0)) +x1 x2) == (.Con, (x3, (x2, ()))) : (List -.Q2 -Nat)}; (LAWS.compile_sound +(compiler.optimize x0) +x1 +x2)

LAWS.gradient_compile_sound : ∀+x0 : compiler.Expr -> ∀+x1 : Nat -> ∀+x2 : (List -.Q2 -Nat) -> {(compiler.exec_vm (compiler.compile (compiler.optimize (compiler.diff x0))) +x1 x2) == (.Con, ((compiler.tangent x0 +x1), (x2, ()))) : (List -.Q2 -Nat)} =
  λ+x0 => λ+x1 => λ+x2 => %(LAWS.diff_correct +x0 +x1) : x3, x4 => {(compiler.exec_vm (compiler.compile (compiler.optimize (compiler.diff x0))) +x1 x2) == (.Con, (x3, (x2, ()))) : (List -.Q2 -Nat)}; (LAWS.optimized_compile_sound +(compiler.diff x0) +x1 +x2)

List.arms : ∀-x0 : <Q0, Q1, Q2> -> ∀-x1 : *(x0) -> ∀x2 : <Nil, Con> -> *(x0) =
  λ-x0 => λ-x1 => λ{.Nil: <()>; λ{.Con: Σx2 : x1 -> Σx3 : (List -x0 -x1) -> <()>; λ{}}}

List : ∀-x0 : <Q0, Q1, Q2> -> ∀-x1 : *(x0) -> *(x0) =
  λ-x0 => λ-x1 => Σx2 : <Nil, Con> -> (List.arms -x0 -x1 x2)

Nat.arms : ∀x0 : <Zero, Succ> -> *(.Q2) =
  λ{.Zero: <()>; λ{.Succ: Σx0 : Nat -> <()>; λ{}}}

Nat : *(.Q2) =
  Σx0 : <Zero, Succ> -> (Nat.arms x0)
