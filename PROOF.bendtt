Equal.sym : ∀-x0 : *(.Q1) -> ∀-x1 : x0 -> ∀-x2 : x0 -> ∀x3 : {x1 == x2 : x0} -> {x2 == x1 : x0} =
  λ-x0 => λ-x1 => λ-x2 => λx3 => %x3 : x4, x5 => {x4 == x1 : x0}; {==}

flip : ∀-x0 : Nat -> ∀-x1 : Nat -> ∀x2 : {x0 == x1 : Nat} -> {x1 == x0 : Nat} =
  λ-x0 => λ-x1 => λx2 => (Equal.sym -Nat -x0 -x1 x2)

LAWS.add_zero_l : ∀+x0 : Nat -> {(Nat.add (.Zero, ()) x0) == x0 : Nat} =
  λ+x0 => {==}

LAWS.add_zero_r : ∀+x0 : Nat -> {(Nat.add x0 (.Zero, ())) == x0 : Nat} =
  λ{(,): λ{.Zero: λ{(): {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): %(LAWS.add_zero_r +x0) : x1, x2 => {(.Succ, ((Nat.add x0 (.Zero, ())), ())) == (.Succ, (x1, ())) : Nat}; {==}; λ{}}}; λ{}}}}

LAWS.add_succ : ∀+x0 : Nat -> ∀+x1 : Nat -> {(Nat.add x0 (.Succ, (x1, ()))) == (.Succ, ((Nat.add x0 x1), ())) : Nat} =
  λ{(,): λ{.Zero: λ{(): λ+x0 => {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): λ+x1 => %(LAWS.add_succ +x0 +x1) : x2, x3 => {(.Succ, ((Nat.add x0 (.Succ, (x1, ()))), ())) == (.Succ, (x2, ())) : Nat}; {==}; λ{}}}; λ{}}}}

LAWS.add_comm : ∀+x0 : Nat -> ∀+x1 : Nat -> {(Nat.add x0 x1) == (Nat.add x1 x0) : Nat} =
  λ{(,): λ{.Zero: λ{(): λ+x0 => %(LAWS.add_zero_r +x0) : x1, x2 => {x1 == (Nat.add x0 (.Zero, ())) : Nat}; {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): λ+x1 => %(flip -(Nat.add x1 (.Succ, (x0, ()))) -(.Succ, ((Nat.add x1 x0), ())) (LAWS.add_succ +x1 +x0)) : x2, x3 => {(.Succ, ((Nat.add x0 x1), ())) == x2 : Nat}; %(LAWS.add_comm +x0 +x1) : x2, x3 => {(.Succ, ((Nat.add x0 x1), ())) == (.Succ, (x2, ())) : Nat}; {==}; λ{}}}; λ{}}}}

LAWS.add_assoc : ∀+x0 : Nat -> ∀+x1 : Nat -> ∀+x2 : Nat -> {(Nat.add (Nat.add x0 x1) x2) == (Nat.add x0 (Nat.add x1 x2)) : Nat} =
  λ{(,): λ{.Zero: λ{(): λ+x0 => λ+x1 => {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): λ+x1 => λ+x2 => %(LAWS.add_assoc +x0 +x1 +x2) : x3, x4 => {(.Succ, ((Nat.add (Nat.add x0 x1) x2), ())) == (.Succ, (x3, ())) : Nat}; {==}; λ{}}}; λ{}}}}

LAWS.add_swap : ∀+x0 : Nat -> ∀+x1 : Nat -> ∀+x2 : Nat -> {(Nat.add x0 (Nat.add x1 x2)) == (Nat.add x1 (Nat.add x0 x2)) : Nat} =
  λ+x0 => λ+x1 => λ+x2 => %(LAWS.add_assoc +x1 +x0 +x2) : x3, x4 => {(Nat.add x0 (Nat.add x1 x2)) == x3 : Nat}; %(LAWS.add_comm +x0 +x1) : x3, x4 => {(Nat.add x0 (Nat.add x1 x2)) == (Nat.add x3 x2) : Nat}; (flip -(Nat.add (Nat.add x0 x1) x2) -(Nat.add x0 (Nat.add x1 x2)) (LAWS.add_assoc +x0 +x1 +x2))

LAWS.mul_zero_l : ∀+x0 : Nat -> {(Nat.mul (.Zero, ()) +x0) == (.Zero, ()) : Nat} =
  λ+x0 => {==}

LAWS.mul_zero_r : ∀+x0 : Nat -> {(Nat.mul x0 +(.Zero, ())) == (.Zero, ()) : Nat} =
  λ{(,): λ{.Zero: λ{(): {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): (LAWS.mul_zero_r +x0); λ{}}}; λ{}}}}

LAWS.mul_one_l : ∀+x0 : Nat -> {(Nat.mul (.Succ, ((.Zero, ()), ())) +x0) == x0 : Nat} =
  λ+x0 => (LAWS.add_zero_r +x0)

LAWS.mul_one_r : ∀+x0 : Nat -> {(Nat.mul x0 +(.Succ, ((.Zero, ()), ()))) == x0 : Nat} =
  λ{(,): λ{.Zero: λ{(): {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): %(LAWS.mul_one_r +x0) : x1, x2 => {(.Succ, ((Nat.mul x0 +(.Succ, ((.Zero, ()), ()))), ())) == (.Succ, (x1, ())) : Nat}; {==}; λ{}}}; λ{}}}}

LAWS.mul_succ_r : ∀+x0 : Nat -> ∀+x1 : Nat -> {(Nat.mul x0 +(.Succ, (x1, ()))) == (Nat.add x0 (Nat.mul x0 +x1)) : Nat} =
  λ{(,): λ{.Zero: λ{(): λ+x0 => {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): λ+x1 => %(LAWS.add_swap +x1 +x0 +(Nat.mul x0 +x1)) : x2, x3 => {(.Succ, ((Nat.add x1 (Nat.mul x0 +(.Succ, (x1, ())))), ())) == (.Succ, (x2, ())) : Nat}; %(LAWS.mul_succ_r +x0 +x1) : x2, x3 => {(.Succ, ((Nat.add x1 (Nat.mul x0 +(.Succ, (x1, ())))), ())) == (.Succ, ((Nat.add x1 x2), ())) : Nat}; {==}; λ{}}}; λ{}}}}

LAWS.mul_comm : ∀+x0 : Nat -> ∀+x1 : Nat -> {(Nat.mul x0 +x1) == (Nat.mul x1 +x0) : Nat} =
  λ{(,): λ{.Zero: λ{(): λ+x0 => %(LAWS.mul_zero_r +x0) : x1, x2 => {x1 == (Nat.mul x0 +(.Zero, ())) : Nat}; {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): λ+x1 => %(flip -(Nat.mul x1 +(.Succ, (x0, ()))) -(Nat.add x1 (Nat.mul x1 +x0)) (LAWS.mul_succ_r +x1 +x0)) : x2, x3 => {(Nat.add x1 (Nat.mul x0 +x1)) == x2 : Nat}; %(LAWS.mul_comm +x0 +x1) : x2, x3 => {(Nat.add x1 (Nat.mul x0 +x1)) == (Nat.add x1 x2) : Nat}; {==}; λ{}}}; λ{}}}}

LAWS.mul_add_l : ∀+x0 : Nat -> ∀+x1 : Nat -> ∀+x2 : Nat -> {(Nat.mul (Nat.add x0 x1) +x2) == (Nat.add (Nat.mul x0 +x2) (Nat.mul x1 +x2)) : Nat} =
  λ{(,): λ{.Zero: λ{(): λ+x0 => λ+x1 => {==}; λ{}}; λ{.Succ: λ{(,): λ+x0 => λ{(): λ+x1 => λ+x2 => %(flip -(Nat.add (Nat.add x2 (Nat.mul x0 +x2)) (Nat.mul x1 +x2)) -(Nat.add x2 (Nat.add (Nat.mul x0 +x2) (Nat.mul x1 +x2))) (LAWS.add_assoc +x2 +(Nat.mul x0 +x2) +(Nat.mul x1 +x2))) : x3, x4 => {(Nat.add x2 (Nat.mul (Nat.add x0 x1) +x2)) == x3 : Nat}; %(LAWS.mul_add_l +x0 +x1 +x2) : x3, x4 => {(Nat.add x2 (Nat.mul (Nat.add x0 x1) +x2)) == (Nat.add x2 x3) : Nat}; {==}; λ{}}}; λ{}}}}

LAWS.mul_add_r : ∀+x0 : Nat -> ∀+x1 : Nat -> ∀+x2 : Nat -> {(Nat.mul x0 +(Nat.add x1 x2)) == (Nat.add (Nat.mul x0 +x1) (Nat.mul x0 +x2)) : Nat} =
  λ+x0 => λ+x1 => λ+x2 => %(LAWS.mul_comm +(Nat.add x1 x2) +x0) : x3, x4 => {x3 == (Nat.add (Nat.mul x0 +x1) (Nat.mul x0 +x2)) : Nat}; %(LAWS.mul_comm +x1 +x0) : x3, x4 => {(Nat.mul (Nat.add x1 x2) +x0) == (Nat.add x3 (Nat.mul x0 +x2)) : Nat}; %(LAWS.mul_comm +x2 +x0) : x3, x4 => {(Nat.mul (Nat.add x1 x2) +x0) == (Nat.add (Nat.mul x1 +x0) x3) : Nat}; (LAWS.mul_add_l +x1 +x2 +x0)

LAWS.mul_assoc : ∀+x0 : Nat -> ∀+x1 : Nat -> ∀+x2 : Nat -> {(Nat.mul (Nat.mul x0 +x1) +x2) == (Nat.mul x0 +(Nat.mul x1 +x2)) : Nat} =
