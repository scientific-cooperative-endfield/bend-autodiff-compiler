Nat.add : ∀x0 : Nat -> ∀x1 : Nat -> Nat =
  λ{(,): λ{.Zero: λ{(): λx0 => x0; λ{}}; λ{.Succ: λ{(,): λx0 => λ{(): λx1 => (.Succ, ((Nat.add x0 x1), ())); λ{}}}; λ{}}}}

Nat.mul : ∀x0 : Nat -> ∀+x1 : Nat -> Nat =
  λ{(,): λ{.Zero: λ{(): λ+x0 => (.Zero, ()); λ{}}; λ{.Succ: λ{(,): λx0 => λ{(): λ+x1 => (Nat.add x1 (Nat.mul x0 +x1)); λ{}}}; λ{}}}}

compiler.eval : ∀x0 : compiler.Expr -> ∀+x1 : Nat -> Nat =
  λ{(,): λ{.compiler.Const: λ{(,): λx0 => λ{(): λ+x1 => x0; λ{}}}; λ{.compiler.Var: λ{(): λ+x0 => x0; λ{}}; λ{.compiler.Add: λ{(,): λx0 => λ{(,): λx1 => λ{(): λ+x2 => !x3 = (compiler.eval x0 +x2); !x4 = (compiler.eval x1 +x2); (Nat.add x3 x4); λ{}}}}; λ{.compiler.Mul: λ{(,): λx0 => λ{(,): λx1 => λ{(): λ+x2 => !x3 = (compiler.eval x0 +x2); !x4 = (compiler.eval x1 +x2); (Nat.mul x3 +x4); λ{}}}}; λ{}}}}}}

compiler.diff : ∀x0 : compiler.Expr -> compiler.Expr =
  λ{(,): λ{.compiler.Const: λ{(,): λx0 => λ{(): (.compiler.Const, ((.Zero, ()), ())); λ{}}}; λ{.compiler.Var: λ{(): (.compiler.Const, ((.Succ, ((.Zero, ()), ())), ())); λ{}}; λ{.compiler.Add: λ{(,): λx0 => λ{(,): λx1 => λ{(): !x2 = (compiler.diff x0); !x3 = (compiler.diff x1); (.compiler.Add, (x2, (x3, ()))); λ{}}}}; λ{.compiler.Mul: λ{(,): λ+x0 => λ{(,): λ+x1 => λ{(): !x2 = (compiler.diff x0); !x3 = (compiler.diff x1); (.compiler.Add, ((.compiler.Mul, (x2, (x1, ()))), ((.compiler.Mul, (x0, (x3, ()))), ()))); λ{}}}}; λ{}}}}}}

compiler.smart_add : ∀x0 : compiler.Expr -> ∀x1 : compiler.Expr -> compiler.Expr =
  λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): (.compiler.Const, ((.Zero, ()), ())); λ{}}; λ{}}; λx0 => λx1 => λ{(): (.compiler.Const, ((x0, x1), ())); λ{}}}}}; λx0 => λx1 => (x0, x1)}}; λ{}}; λ{}}; λx0 => λx1 => λ{(): λx2 => (λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λx3 => λx4 => (.compiler.Const, ((x3, x4), ())); λ{}}; λ{}}; λx3 => λx4 => λ{(): λx5 => λx6 => (.compiler.Const, ((Nat.add (x5, x6) (x3, x4)), ())); λ{}}}}}; λx3 => λx4 => λx5 => λx6 => (.compiler.Add, ((.compiler.Const, ((x5, x6), ())), ((x3, x4), ())))}} x2 x0 x1); λ{}}}}}; λx0 => λx1 => λx2 => (λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λx3 => λx4 => (x3, x4); λ{}}; λ{}}; λx3 => λx4 => λ{(): λx5 => λx6 => (.compiler.Add, ((x5, x6), ((.compiler.Const, ((x3, x4), ())), ()))); λ{}}}}}; λx3 => λx4 => λx5 => λx6 => (.compiler.Add, ((x5, x6), ((x3, x4), ())))}} x2 x0 x1)}}

compiler.smart_mul : ∀x0 : compiler.Expr -> ∀x1 : compiler.Expr -> compiler.Expr =
  λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): (.compiler.Const, ((.Zero, ()), ())); λ{}}; λ{}}; λ{.Succ: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λ{(): (.compiler.Const, ((.Zero, ()), ())); λ{}}; λ{}}; λ{}}; λx0 => λx1 => λ{(): λ{(): (.compiler.Const, ((.Zero, ()), ())); λ{}}; λ{}}}}}; λ{}}}}}; λx0 => λx1 => (.compiler.Const, ((.Zero, ()), ()))}}; λ{}}; λ{}}; λ{.Succ: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λ{(): λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): (.compiler.Const, ((.Zero, ()), ())); λ{}}; λ{}}; λ{.Succ: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λ{(): (.compiler.Const, ((.Succ, ((.Zero, ()), ())), ())); λ{}}; λ{}}; λ{}}; λx0 => λx1 => λ{(): λ{(): (.compiler.Const, ((.Succ, ((x0, x1), ())), ())); λ{}}; λ{}}}}}; λ{}}}}}; λx0 => λx1 => (x0, x1)}}; λ{}}; λ{}}; λ{}}; λx0 => λx1 => λ{(): λ{(): λx2 => (λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λx3 => λx4 => (.compiler.Const, ((.Zero, ()), ())); λ{}}; λ{}}; λ{.Succ: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λ{(): λx3 => λx4 => (.compiler.Const, ((.Succ, ((x3, x4), ())), ())); λ{}}; λ{}}; λ{}}; λx3 => λx4 => λ{(): λ{(): λx5 => λx6 => (.compiler.Const, ((Nat.mul (.Succ, ((x5, x6), ())) +(.Succ, ((x3, x4), ()))), ())); λ{}}; λ{}}}}}; λ{}}}}}; λx3 => λx4 => λx5 => λx6 => (.compiler.Mul, ((.compiler.Const, ((.Succ, ((x5, x6), ())), ())), ((x3, x4), ())))}} x2 x0 x1); λ{}}; λ{}}}}}; λ{}}}}}; λx0 => λx1 => λx2 => (λ{(,): λ{.compiler.Const: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λx3 => λx4 => (.compiler.Const, ((.Zero, ()), ())); λ{}}; λ{}}; λ{.Succ: λ{(,): λ{(,): λ{.Zero: λ{(): λ{(): λ{(): λx3 => λx4 => (x3, x4); λ{}}; λ{}}; λ{}}; λx3 => λx4 => λ{(): λ{(): λx5 => λx6 => (.compiler.Mul, ((x5, x6), ((.compiler.Const, ((.Succ, ((x3, x4), ())), ())), ()))); λ{}}; λ{}}}}}; λ{}}}}}; λx3 => λx4 => λx5 => λx6 => (.compiler.Mul, ((x5, x6), ((x3, x4), ())))}} x2 x0 x1)}}

compiler.optimize : ∀x0 : compiler.Expr -> compiler.Expr =
  λ{(,): λ{.compiler.Const: λ{(,): λx0 => λ{(): (.compiler.Const, (x0, ())); λ{}}}; λ{.compiler.Var: λ{(): (.compiler.Var, ()); λ{}}; λ{.compiler.Add: λ{(,): λx0 => λ{(,): λx1 => λ{(): !x2 = (compiler.optimize x0); !x3 = (compiler.optimize x1); (compiler.smart_add x2 x3); λ{}}}}; λ{.compiler.Mul: λ{(,): λx0 => λ{(,): λx1 => λ{(): !x2 = (compiler.optimize x0); !x3 = (compiler.optimize x1); (compiler.smart_mul x2 x3); λ{}}}}; λ{}}}}}}

compiler.tangent : ∀x0 : compiler.Expr -> ∀+x1 : Nat -> Nat =
  λ{(,): λ{.compiler.Const: λ{(,): λx0 => λ{(): λ+x1 => (.Zero, ()); λ{}}}; λ{.compiler.Var: λ{(): λ+x0 => (.Succ, ((.Zero, ()), ())); λ{}}; λ{.compiler.Add: λ{(,): λx0 => λ{(,): λx1 => λ{(): λ+x2 => !x3 = (compiler.tangent x0 +x2); !x4 = (compiler.tangent x1 +x2); (Nat.add x3 x4); λ{}}}}; λ{.compiler.Mul: λ{(,): λ+x0 => λ{(,): λ+x1 => λ{(): λ+x2 => !x3 = (compiler.tangent x0 +x2); !x4 = (compiler.tangent x1 +x2); (Nat.add (Nat.mul x3 +(compiler.eval x1 +x2)) (Nat.mul (compiler.eval x0 +x2) +x4)); λ{}}}}; λ{}}}}}}

compiler.Instr.arms : ∀x0 : <compiler.PushConst, compiler.PushVar, compiler.OpAdd, compiler.OpMul> -> *(.Q2) =
  λ{.compiler.PushConst: Σx0 : Nat -> <()>; λ{.compiler.PushVar: <()>; λ{.compiler.OpAdd: <()>; λ{.compiler.OpMul: <()>; λ{}}}}}

compiler.Instr : *(.Q2) =
  Σx0 : <compiler.PushConst, compiler.PushVar, compiler.OpAdd, compiler.OpMul> -> (compiler.Instr.arms x0)

compiler.append : ∀x0 : (List -.Q2 -compiler.Instr) -> ∀x1 : (List -.Q2 -compiler.Instr) -> (List -.Q2 -compiler.Instr) =
  λ{(,): λ{.Nil: λ{(): λx0 => x0; λ{}}; λ{.Con: λ{(,): λx0 => λ{(,): λx1 => λ{(): λx2 => (.Con, (x0, ((compiler.append x1 x2), ()))); λ{}}}}; λ{}}}}

compiler.compile : ∀x0 : compiler.Expr -> (List -.Q2 -compiler.Instr) =
  λ{(,): λ{.compiler.Const: λ{(,): λx0 => λ{(): (.Con, ((.compiler.PushConst, (x0, ())), ((.Nil, ()), ()))); λ{}}}; λ{.compiler.Var: λ{(): (.Con, ((.compiler.PushVar, ()), ((.Nil, ()), ()))); λ{}}; λ{.compiler.Add: λ{(,): λx0 => λ{(,): λx1 => λ{(): !x2 = (compiler.compile x0); !x3 = (compiler.compile x1); (compiler.append x2 (compiler.append x3 (.Con, ((.compiler.OpAdd, ()), ((.Nil, ()), ()))))); λ{}}}}; λ{.compiler.Mul: λ{(,): λx0 => λ{(,): λx1 => λ{(): !x2 = (compiler.compile x0); !x3 = (compiler.compile x1); (compiler.append x2 (compiler.append x3 (.Con, ((.compiler.OpMul, ()), ((.Nil, ()), ()))))); λ{}}}}; λ{}}}}}}

compiler.step : ∀x0 : compiler.Instr -> ∀x1 : Nat -> ∀x2 : (List -.Q2 -Nat) -> (List -.Q2 -Nat) =
  λ{(,): λ{.compiler.PushConst: λ{(,): λx0 => λ{(): λx1 => λx2 => (.Con, (x0, (x2, ()))); λ{}}}; λ{.compiler.PushVar: λ{(): λx0 => λx1 => (.Con, (x0, (x1, ()))); λ{}}; λ{.compiler.OpAdd: λ{(): λx0 => λ{(,): λ{.Con: λ{(,): λx1 => λ{(,): λ{(,): λ{.Con: λ{(,): λx2 => λ{(,): λx3 => λ{(): λ{(): (.Con, ((Nat.add x2 x1), (x3, ()))); λ{}}; λ{}}}}; λx2 => λx3 => λ{(): (.Nil, ()); λ{}}}}}}; λx1 => λx2 => (.Nil, ())}}; λ{}}; λ{.compiler.OpMul: λ{(): λx0 => λ{(,): λ{.Con: λ{(,): λx1 => λ{(,): λ{(,): λ{.Con: λ{(,): λx2 => λ{(,): λx3 => λ{(): λ{(): (.Con, ((Nat.mul x2 +x1), (x3, ()))); λ{}}; λ{}}}}; λx2 => λx3 => λ{(): (.Nil, ()); λ{}}}}}}; λx1 => λx2 => (.Nil, ())}}; λ{}}; λ{}}}}}}

compiler.exec_vm : ∀x0 : (List -.Q2 -compiler.Instr) -> ∀+x1 : Nat -> ∀x2 : (List -.Q2 -Nat) -> (List -.Q2 -Nat) =
  λ{(,): λ{.Nil: λ{(): λ+x0 => λx1 => x1; λ{}}; λ{.Con: λ{(,): λx0 => λ{(,): λx1 => λ{(): λ+x2 => λx3 => (compiler.exec_vm x1 +x2 (compiler.step x0 x2 x3)); λ{}}}}; λ{}}}}

compiler.nodes : ∀x0 : compiler.Expr -> Nat =
