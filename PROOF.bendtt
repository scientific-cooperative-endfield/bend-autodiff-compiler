compiler.Expr.arms : ∀x0 : <compiler.Const, compiler.Var, compiler.Add, compiler.Mul> -> *(.Q2) =
  λ{.compiler.Const: Σx0 : Nat -> <()>; λ{.compiler.Var: <()>; λ{.compiler.Add: Σx0 : compiler.Expr -> Σx1 : compiler.Expr -> <()>; λ{.compiler.Mul: Σx0 : compiler.Expr -> Σx1 : compiler.Expr -> <()>; λ{}}}}}

compiler.Expr : *(.Q2) =
